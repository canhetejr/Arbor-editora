 */const $A = [["path", { d: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2", key: "1yyitq" }], ["path", { d: "M16 3.128a4 4 0 0 1 0 7.744", key: "16gr8j" }], ["path", { d: "M22 21v-2a4 4 0 0 0-3-3.87", key: "kshegd" }], ["circle", { cx: "9", cy: "7", r: "4", key: "nufk8" }]], ev = Le("users", $A), Fo = [{ editora: "Editora Appris", valor: "Não informa um valor fechado. Indica modelo 80/20, em que a editora financia cerca de 80% e o autor investe em média até 20% dos custos de publicação.", observacao: "Trabalha com proposta individualizada. A página também informa diagnóstico sem custo e proposta com três modelos de orçamento." }, { editora: "Editora Dialética", valor: "R$ 1.072,00 no Pacote Especial; R$ 2.495,00 no Pacote Premium.", observacao: "O Pacote Especial aparece voltado ao formato físico; o Premium inclui físico, e-book e audiobook com voz de IA. Ambos mencionam 50% de direitos autorais sobre lucro líquido." }, { editora: "Editora CRV", valor: "Não localizei tabela pública de preço.", observacao: "O site descreve submissão, avaliação, ISBN, ficha catalográfica, DOI, edição, projeto visual, diagramação, publicação, impressão, lançamento e divulgação, mas o valor parece ser informado por proposta/contrato." }, { editora: "Editora Viseu", valor: "A partir de R$ 3.600,00; em outro conteúdo, a partir de R$ 4.500,00; também aparece faixa de R$ 3.600,00 a R$ 100.000,00.", observacao: "O valor varia conforme tamanho da obra, produção, cópias, distribuição, divulgação, ilustrações e tipo de capa. A editora informa que os autores ficam com 50% dos lucros das vendas." }, { editora: "Editora Íthala", valor: "Não localizei tabela pública de preço.", observacao: "O site informa serviços como homologação/ISBN, impressão, impressão sob demanda, projeto gráfico, diagramação, arte-final, layout de capa e revisão, mas sem valores públicos." }], Ko = [{ caracteristica: "E-commerce", leader: "X", expert: "", ithala: "X", viseu: "" }, { caracteristica: "Material Didático", leader: "", expert: "X", ithala: "X", viseu: "" }, { caracteristica: "Coletâneas", leader: "X", expert: "", ithala: "X", viseu: "X" }, { caracteristica: "Serviços", leader: "Publique seu livro, Projeto de Coautoria, Biografias Empresariais, Leader Acadêmicos, Distribuição", expert: "Publique sua tese, Distribuição gratuita", ithala: "prestação de serviços editoriais para autores, publicação independente, comercialização direta de livros em loja própria e distribuição por canais físicos e digitais.", viseu: "Avaliação editorial, orçamento, revisão, capa, diagramação, impressão, distribuição, assessoria de imprensa, pré-venda, lançamento e tráfego pago." }, { caracteristica: "Tipos de materiais", leader: "Amplo catálogo geral", expert: "Teses, dissertações e acadêmicos em geral", ithala: "catálogo é amplo, mas há forte concentração em obras jurídicas, acadêmicas, técnicas e profissionais. As categorias visíveis incluem Administração/Contabilidade, Auditoria, Concursos, Educação, Engenharia, História, Infantil, Jurídicos, Literatura, Marketing, Saúde, Segurança Pública, E-book, entre outras. Dentro de Jurídicos, há subdivisões como Direito Administrativo, Direito Ambiental, Direito Civil, Direito Constitucional, Direito Digital, Direito Penal, Direito Tributário, Direitos Humanos, Políticas Públicas e Relações Internacionais", viseu: "estrategicamente, a Viseu se posiciona como uma editora de publicação assistida para autores independentes e estreantes, com forte ênfase em marketing, distribuição em marketplaces, presença digital e captação de novos autores. O diferencial competitivo está no discurso de escala, no volume de autores publicados, na rede de marketplaces e no pacote de serviços para lançamento." }], gc = ["Avaliação por comitês científicos nacionais e internacionais, distribuídos em 29 coleções científicas, formada por doutores e pós-doutores de renome nacional e internacional;", "Leitura minuciosa com feedback e sugestões de alterações e melhorias na apresentação dos textos;", "A revisão em duas etapas, com correções na ortografia e gramática, com atenção a incoerências, repetições, sugestões de melhorias na clareza e fluidez dos textos;", "Intervenções na normatização em atendimento às normas da ABNT e padronização pelos critérios da CAPES;", "Cumprimos integralmente o item Editora da CAPES, para classificação de livros científicos;", "Estudo gráfico e projeto visual feitos por equipe especializada em design gráfico, a partir de briefing com autor para detalhamento de suas expectativas;", "Diagramação padronizada contemplando todos os requisitos normativos e critérios do roteiro de avaliação de livros pela CAPES;", "O autor recebe uma print (boneco do livro impresso e entregue via correios) para sua revisão e conferência de qualidade de materiais;", "Capa personalizada - projeto visual de capa baseado no Briefing enviado pelo autor, detalhando suas aspirações;", "ISBN, DOI e ficha catalográfica;", "E-book 3.0;", "Apresentação e disponibilização para a consignação da obra (quando solicitado pelos livreiros) nos catálogos das grandes livrarias físicas;", "Apresentação e disponibilização da obra em catálogos eletrônicos das livrarias online e marketplaces nacionais;", "Seu livro impresso disponível para compra pelo site da Appris com milhares de acessos mensais;", "A editora acata a solicitação dos autores que indicam eventos (em parcerias com livreiros de todo o Brasil) nos quais desejam que seu livro seja comercializado de acordo com a sua temática e área;", "Lançamento personalizado na cidade do autor (em livrarias), agendado pela editora, com convite eletrônico e banner cortesia;", "E-book comercializado nas grandes redes online e marketplaces nacionais e no exterior, inclusive pela Amazon Internacional;", "A grande parceria Grupo Editorial Appris - Amazon, garante aos autores a pré-venda em destaque na plataforma da Amazon pelo período de até 40 dias antes do lançamento. Essa ação promove grande interesse dos leitores;", "O seu livro poderá ser selecionado para exclusividade de 60 dias na plataforma Amazon;", "Cumprimento da lei do depósito legal, da Fundação Biblioteca Nacional;", "Desconto progressivo para os autores adquirirem exemplares do seu livro;", "Folders eletrônicos para o autor oferecer descontos para seus contatos, alunos e colegas;", "Autor tem acesso livre ao e-book para presentear a seus pares notórios e amigos;", "Um banner grande, com a capa do livro, para exposição no espaço de autógrafos;", "Seu livro é apresentado como pauta para uma série de jornalistas e imprensa com editorias coerentes ao tema de seu livro;", "Inserção do livro no Catálogo de Apostas da Appris, enviado semanalmente para um mailing exclusivo de livrarias e compradores livreiros;", "Utilização do código BISAC para cadastrar os livros - moderna estrutura de cadastramento que aumenta a visualização e alcance de seu livro nos portais e pontos de venda."], Tf = [{ id: "145012.01", quantidade: 10, tipo: "Dorso Colado", capa: "31x21cm, 4x0 cores em Couche Fosco FSC 300g. Arte Fornecida pelo Cliente. Prova Digital Konica Minolta.", miolo: "100 pgs, 15x21cm, 1 cor em Off Set Alto Alvura Suzano 75g. Prova Digital Konica Minolta.", lombada: "4mm, Laminado Fosco, Nº lados 1(Capa), Vinco(Capa), Intercalação(Miolo), Colagem PUR, FRETE, FOB (Destinatário).", unitario: 100, total: 1e3, pagamento: "14 dias em boleto" }, { id: "145012.02", quantidade: 10, tipo: "Dorso Colado", capa: "31x21cm, 4x0 cores em Couche Fosco FSC 300g. Arte Fornecida pelo Cliente. Prova Digital Konica Minolta.", miolo: "200 pgs, 15x21cm, 1 cor em Off Set Alto Alvura Suzano 75g. Prova Digital Konica Minolta.", lombada: "8mm, Laminado Fosco, Nº lados 1(Capa), Vinco(Capa), Intercalação(Miolo), Colagem PUR, FRETE, FOB (Destinatário).", unitario: 140, total: 1400, pagamento: "14 dias em boleto" }, { id: "145012.03", quantidade: 50, tipo: "Dorso Colado", capa: "31x21cm, 4x0 cores em Couche Fosco FSC 300g. Arte Fornecida pelo Cliente. Prova