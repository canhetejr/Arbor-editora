    @layer base {

      *,
      :after,
      :before,
      ::backdrop {
        box-sizing: border-box;
        border: 0 solid;
        margin: 0;
        padding: 0
      }

      ::file-selector-button {
        box-sizing: border-box;
        border: 0 solid;
        margin: 0;
        padding: 0
      }

      html,
      :host {
        -webkit-text-size-adjust: 100%;
